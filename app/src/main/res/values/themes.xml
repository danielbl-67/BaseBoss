<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BaseBoss" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores Primarios -->
        <item name="colorPrimary">@color/color_primario</item>
        <item name="colorOnPrimary">@color/texto_claro</item>
        <item name="colorSecondary">@color/color_secundario</item>
        <item name="colorOnSecondary">@color/texto_claro</item>

        <!-- Fondos y Ventanas -->
        <item name="android:windowBackground">@color/color_fondo</item>
        <item name="colorSurface">@color/color_superficie</item>
        <item name="colorOnSurface">@color/texto_primario</item>

        <!-- Barra de estado -->
        <item name="android:statusBarColor">@color/color_primario_variante</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>